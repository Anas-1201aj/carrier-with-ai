{
  "name": "build-career-pilot-ai-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm dev:all",
    "dev:all": "pnpm --parallel -r dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "pnpm --dir backend dev",
    "build": "pnpm --dir frontend build",
    "build:backend": "pnpm --dir backend build",
    "start:backend": "pnpm --dir backend start",
    "install:all": "pnpm install"
  }
}
